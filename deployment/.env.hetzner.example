# Copy to .env.hetzner on the server and replace every placeholder.
# Keep this file separate from the app secrets in the repository-root .env.
APP_IMAGE=ghcr.io/robert-velhorst/006-autoreminder-virtualworkers:replace-with-release-tag
MIGRATION_IMAGE=ghcr.io/robert-velhorst/006-autoreminder-virtualworkers:replace-with-release-tag-migrate
DASHBOARD_HOST_PORT=3025
APP_ENV_FILE=.env.app

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=va_dashboard
MYSQL_USER=va_dashboard
MYSQL_PASSWORD=replace-with-a-long-random-app-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# URL-encode reserved characters in both passwords below.
DATABASE_URL=mysql://va_dashboard:URL_ENCODED_APP_PASSWORD@mysql:3306/va_dashboard
REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379
PUBLIC_URL=https://dashboard.example.com
WEBHOOK_BASE_URL=https://dashboard.example.com
