{
  "name": "va-dashboard",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --external:./vite.js --outdir=dist && esbuild server/scripts/reanalyze_all.ts server/scripts/reanalyze_active_placeholders.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/tools && node scripts/build-codex-bridge.mjs && tsx scripts/seal-aptlss-build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "check:db-transfer": "tsc --noEmit --ignoreConfig --target ES2022 --module ESNext --moduleResolution bundler --esModuleInterop --skipLibCheck --types node scripts/migrate-mysql-to-postgres.ts server/scripts/mysqlPostgresTransferCore.ts",
    "format": "prettier --write .",
    "test": "vitest run --maxWorkers=4 && node --test scripts/doctor.test.mjs scripts/manager-codex-supervisor.test.mjs e2e/api-rate-window.test.mjs scripts/operator-data-transfer-utils.test.mjs scripts/verify-postgres-production-image.test.mjs scripts/image-vulnerability-policy.test.mjs scripts/scan-production-image.test.mjs scripts/promote-scanned-image.test.mjs scripts/image-release-workflow.test.mjs deployment/hetzner/production-gate.test.mjs deployment/hetzner/deploy-script.test.mjs deployment/hetzner/deploy-script.integration.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:verify-mysql-legacy": "tsx scripts/verify-schema-parity.ts",
    "db:verify-parity": "tsx scripts/verify-postgres-schema-parity.ts",
    "db:migrate:mysql-to-postgres": "tsx scripts/migrate-mysql-to-postgres.ts",
    "operator:data:export": "node scripts/operator-data-transfer.mjs export",
    "operator:data:import": "node scripts/operator-data-transfer.mjs import",
    "operator:data:reconcile": "node scripts/operator-data-transfer.mjs reconcile",
    "owner:provision": "tsx scripts/provision-owner.ts",
    "docker:build": "docker build -t va-dashboard:latest .",
    "docker:run": "docker compose --env-file .env up -d",
    "docker:stop": "docker compose --env-file .env down",
    "docker:logs": "docker compose --env-file .env logs -f app",
    "test:aptlss-safety": "tsx scripts/verify-aptlss-safety.ts",
    "test:codex-supervisor": "node --test scripts/manager-codex-supervisor.test.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "dashboard:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-dashboard.ps1",
    "doctor": "node scripts/doctor.mjs",
    "test:legacy-mysql": "node scripts/run-mysql-integration.mjs"
  },
