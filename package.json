{
  "name": "va-dashboard",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --external:./vite.js --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "check:db-transfer": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --esModuleInterop --skipLibCheck --types node scripts/migrate-mysql-to-postgres.ts server/scripts/mysqlPostgresTransferCore.ts",
    "format": "prettier --write .",
    "test": "vitest run --maxWorkers=4 && node --test scripts/operator-data-transfer-utils.test.mjs deployment/hetzner/production-gate.test.mjs deployment/hetzner/deploy-script.test.mjs deployment/hetzner/deploy-script.integration.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:verify-mysql-legacy": "tsx scripts/verify-schema-parity.ts",
    "db:verify-parity": "tsx scripts/verify-postgres-schema-parity.ts",
    "db:migrate:mysql-to-postgres": "tsx scripts/migrate-mysql-to-postgres.ts",
    "operator:data:export": "node scripts/operator-data-transfer.mjs export",
    "operator:data:import": "node scripts/operator-data-transfer.mjs import",
    "operator:data:reconcile": "node scripts/operator-data-transfer.mjs reconcile",
    "docker:build": "docker build -t va-dashboard:latest .",
    "docker:run": "docker compose --env-file .env up -d",
    "docker:stop": "docker compose --env-file .env down",
    "docker:logs": "docker compose --env-file .env logs -f app"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sendgrid/mail": "^8.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.18",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.2",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^2.0.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
