# ============================================================
# VA DASHBOARD — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit your real .env file to GitHub.
# Variables marked REQUIRED must be set for the app to start.
# Variables marked OPTIONAL can be left blank or commented out.
# ============================================================

# ── DATABASE (REQUIRED) ──────────────────────────────────────
# MySQL connection string.
# Quickest local option:
#   docker run --name va-mysql -e MYSQL_ROOT_PASSWORD=rootpass \
#     -e MYSQL_DATABASE=va_dashboard -p 3306:3306 -d mysql:8.0
DATABASE_URL=mysql://root:password@localhost:3306/va_dashboard

# ── TRELLO (REQUIRED) ────────────────────────────────────────
# Get your key and token at: https://trello.com/app-key
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here
# Optional: use a separate Power-Up API key for browser sign-in. This is
# useful when the public dashboard origin is allowlisted on a new key while
# a trusted server token remains attached to the existing integration key.
TRELLO_LOGIN_API_KEY=

# Google evidence (optional but required for dashboard-managed Gmail and Drive intake)
# Create an OAuth client in Google Cloud with Gmail read-only and Drive metadata read-only
# scopes. The worker completes the consent flow from Settings; refresh tokens are encrypted
# with JWT_SECRET in the database. GOOGLE_REFRESH_TOKEN remains an optional service fallback.
# The application never sends, archives, labels, or changes Gmail messages.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Your Trello member ID. Get it from:
# https://api.trello.com/1/members/me?key=YOUR_KEY&token=YOUR_TOKEN
OWNER_OPEN_ID=your_trello_user_id
OWNER_NAME=Your Name

# ── SESSION SECRET (REQUIRED) ────────────────────────────────
# Any random string, minimum 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# ── AI / LLM (REQUIRED for AI features) ─────────────────────
# OpenAI is the only production model provider. OPENAI_API_KEY is required
# when NODE_ENV=production. The model catalog is discovered automatically.
OPENAI_API_KEY=
# Optional pin. Leave empty to select the best compatible model exposed by this key.
OPENAI_MODEL=
# Completion deadline in milliseconds. Defaults to 120000 and is capped at 300000.
OPENAI_REQUEST_TIMEOUT_MS=120000

# ── APP CONFIG (OPTIONAL) ────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
VITE_APP_TITLE=VA Task Dashboard
VITE_APP_LOGO=/logo.png
VITE_APP_ID=va-dashboard

# Loopback development only. The server rejects this in production or on a
# non-loopback HOST. Set LOCAL_AUTH_BYPASS_OPEN_ID when multiple workers exist.
LOCAL_AUTH_BYPASS=false
LOCAL_AUTH_BYPASS_OPEN_ID=

# Optional one-time recovery for an existing admin that has no password.
# Set both values, restart, use the login page setup form once, then remove them.
OWNER_BOOTSTRAP_OPEN_ID=
OWNER_BOOTSTRAP_TOKEN=

# ── REDIS (OPTIONAL) ─────────────────────────────────────────
# Enables distributed caching and multi-instance WebSocket sync.
# Without Redis the app falls back to MySQL cache — fully functional.
# Start Redis: docker run --name va-redis -p 6379:6379 -d redis:7-alpine
# REDIS_URL=redis://localhost:6379
# Required by docker-compose.yml. Generate a unique password for each deployment.
REDIS_PASSWORD=

# ── TRELLO WEBHOOKS (OPTIONAL) ───────────────────────────────
# Required only for real-time Trello push updates (card changes trigger the app).
# Must be a publicly reachable HTTPS URL.
# For local development use ngrok:
#   ngrok http 3000
#   Then set: WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
# Without this, manual sync still works — webhooks just won't auto-trigger.
# WEBHOOK_BASE_URL=https://your-public-domain.com
# The callback POST is rejected unless its Trello HMAC can be verified.
# TRELLO_WEBHOOK_CALLBACK_URL=https://your-public-domain.com/api/trello-webhook
# Comma-separated browser origins allowed to use the authenticated Socket.IO endpoint.
# LOCAL_ACCESS_ORIGINS=http://127.0.0.1:3025,http://localhost:3025
# TRELLO_WEBHOOK_SECRET=your_trello_application_secret
# Webhook registration, database preload, evidence sync, compliance, weekly
# analysis, and the APTLSS queue are configured in Settings -> Maintenance.

# ── EMAIL NOTIFICATIONS (OPTIONAL) ──────────────────────────
# External delivery is disabled until this is explicitly true. This gate covers
# outbound email and automated Trello comments; in-app notifications still work.
# Select "gmail_api" after connecting the owner Gmail account in Settings.
# This is the recommended provider: no app password is stored. "gmail_smtp"
# and "sendgrid" remain optional fallbacks. Never use a regular Gmail password.
EMAIL_PROVIDER=
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
NOTIFICATIONS_ENABLED=false

# ── CONCURRENCY TUNING (OPTIONAL) ────────────────────────────
MAX_CONCURRENT_REQUESTS=100
REQUEST_QUEUE_TIMEOUT_MS=30000

# ── LOGGING (OPTIONAL) ───────────────────────────────────────
# Levels: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── APP URL (OPTIONAL) ───────────────────────────────────────
APP_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:3000
# Public callback registered in the Trello API key allowed origins. In production,
# prefer this exact URL over deriving it from the active browser origin.
TRELLO_LOGIN_RETURN_URL=

# ── NOT NEEDED FOR LOCAL DEV ─────────────────────────────────
# These were used by the original Manus-hosted environment.
# Local auth (username/password) works without them.
# Leave as-is or remove — they have no effect on local dev.
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im

# Analytics (optional, dummy values to prevent Vite build/dev warnings)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Durable reminder worker. External email reminders always require explicit approval.
REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL_MS=60000
BRIEFING_SCHEDULER_ENABLED=false
# Number of trusted reverse-proxy hops. Docker/ngrok uses one hop by default.
TRUST_PROXY_HOPS=1
