# ============================================================
# VA DASHBOARD — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit your real .env file to GitHub.
# Variables marked REQUIRED must be set for the app to start.
# Variables marked OPTIONAL can be left blank or commented out.
# ============================================================

# ── DATABASE (REQUIRED) ──────────────────────────────────────
# PostgreSQL connection string.
# PostgreSQL must be provisioned separately; Docker Compose runs the app only.
# For a PostgreSQL server on the same Docker host, use:
#   DATABASE_URL=postgresql://va_dashboard:replace_me@host.docker.internal:5432/va_dashboard
# In production, append ?sslmode=verify-full to verify the server certificate
# and hostname using the Node.js TLS trust configuration.
DATABASE_URL=postgresql://va_dashboard:replace_with_a_unique_password@host.docker.internal:5432/va_dashboard

# Cutover-only legacy source. Use a read-only MySQL account and remove this
# variable after migration; it is never used by the application runtime.
# LEGACY_MYSQL_DATABASE_URL=mysql://readonly_user:replace_me@legacy-host:3306/legacy_database

# ── TRELLO (REQUIRED) ────────────────────────────────────────
# Get your key and token at: https://trello.com/app-key
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here

# Your Trello member ID. Get it from:
# https://api.trello.com/1/members/me?key=YOUR_KEY&token=YOUR_TOKEN
OWNER_OPEN_ID=your_trello_user_id
OWNER_NAME=Your Name

# ── SESSION SECRET (REQUIRED) ────────────────────────────────
# Any random string, minimum 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# ── AI / LLM (OPTIONAL) ──────────────────────────────────────
# AI uses the private Codex subscription bridge, starting at Luna low and
# escalating to medium/high only when needed. There is no paid API fallback.
# Configure the queue below. Keep Codex authentication and its executable on
# the private bridge host, never in this application environment or Git.
# Without a connected bridge, AI-backed work is unavailable; deterministic
# fallbacks apply only where explicitly implemented and labeled.

# ── APP CONFIG (OPTIONAL) ────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
VITE_APP_TITLE=VA Task Dashboard
VITE_APP_LOGO=/logo.png
VITE_APP_ID=va-dashboard

# Loopback development only. The server rejects this in production or on a
# non-loopback HOST. Set LOCAL_AUTH_BYPASS_OPEN_ID when multiple workers exist.
LOCAL_AUTH_BYPASS=false
LOCAL_AUTH_BYPASS_OPEN_ID=

# ── REDIS (OPTIONAL) ─────────────────────────────────────────
# Enables distributed caching and multi-instance WebSocket sync.
# Without Redis the app falls back to process-local cache.
# Redis is external/optional; Compose does not start a Redis container.
# REDIS_URL=redis://localhost:6379
# Required by docker-compose.yml. Generate a unique password for each deployment.
REDIS_PASSWORD=

# ── TRELLO WEBHOOKS (OPTIONAL) ───────────────────────────────
# Required only for Trello push updates. Configure the exact HTTPS callback URL
# and the Trello app secret used to sign X-Trello-Webhook requests. The callback
# path must be /api/trello-webhook. Without these, webhook registration and
# callback processing fail closed; manual sync remains available.
# In production, set PUBLIC_URL, APP_URL, and VITE_FRONTEND_URL to the stable
# HTTPS origin (no trailing path); do not use the localhost defaults below.
# PUBLIC_URL=https://your-public-domain.com
# TRELLO_WEBHOOK_CALLBACK_URL=https://your-public-domain.com/api/trello-webhook
# TRELLO_WEBHOOK_SECRET=your_trello_app_secret

# ── EMAIL NOTIFICATIONS (OPTIONAL) ──────────────────────────
# Leave blank to disable email. In-app notifications still work without this.
# Get a free SendGrid account at: https://sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
NOTIFICATIONS_ENABLED=false

# ── CONCURRENCY TUNING (OPTIONAL) ────────────────────────────
MAX_CONCURRENT_REQUESTS=100
REQUEST_QUEUE_TIMEOUT_MS=30000

# ── LOGGING (OPTIONAL) ───────────────────────────────────────
# Levels: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── APP URL (OPTIONAL) ───────────────────────────────────────
APP_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:3000

# ── OPTIONAL EXTERNAL OAUTH ──────────────────────────────────
# Local password and Trello login do not require this compatibility flow.
# External OAuth also requires VITE_APP_ID and an explicit canonical PUBLIC_URL
# matching the registered /api/oauth/callback. The server issues expiring,
# browser-bound single-use state; never construct authorization URLs manually.
# Leave these blank when external OAuth is not deliberately configured.
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im

# Analytics (optional, dummy values to prevent Vite build/dev warnings)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=


# Additive shadow-pilot feature settings. Provider effects remain gated.
TRELLO_LOGIN_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APTLSS_MANAGER_PILOT_WORKER_IDS=
APTLSS_MANAGER_SHADOW_ONLY=true
APTLSS_MANAGER_SCHEDULER=false
APTLSS_MANAGER_COMPACT_HISTORY=true
APTLSS_SAFETY_ATTESTATION=
BACKGROUND_JOBS_ENABLED=true
OWNER_BOOTSTRAP_OPEN_ID=
OWNER_BOOTSTRAP_TOKEN=
EMAIL_PROVIDER=
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
FOUNDER_DECISION_ALERTS_ENABLED=true
TRELLO_LOGIN_RETURN_URL=
REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL_MS=60000
BRIEFING_SCHEDULER_ENABLED=false
TRUST_PROXY_HOPS=1
APTLSS_MANAGER_PROVIDER=codex-subscription
APTLSS_CODEX_QUEUE_DIR=
# Host-only bridge settings: keep these out of the app container environment.
# Run the bridge from its private workspace; all queue/work paths remain within it.
# APTLSS_CODEX_EXECUTABLE=/absolute/path/to/official/codex
# APTLSS_CODEX_PRIVATE_DIR=/private/workspace/manager-private
# APTLSS_CODEX_LLM_PRIVATE_DIR=/private/workspace/conversation-private
