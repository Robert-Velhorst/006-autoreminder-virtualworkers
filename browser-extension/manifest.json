{
  "manifest_version": 3,
  "name": "Worker Browser Hygiene",
  "version": "1.2.1",
  "description": "Explicitly paired browser-tab compliance collector for the worker dashboard.",
  "permissions": ["alarms", "storage", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Review open work tabs", "default_popup": "popup.html" },
  "options_page": "options.html"
}
